{
  "name": "badminton",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/sync-public.js",
    "estimator": "node scripts/train-estimator.js",
    "snapshot": "node scripts/generate-snapshot.js",
    "build:fresh": "npm run estimator && npm run snapshot && npm run build",
    "test": "npm run test:chain && npm run test:participant-ownership && npm run test:member-exit-analysis && npm run test:best-partners && npm run test:court-pricing && npm run test:estimator",
    "test:chain": "node scripts/verify-chain.js",
    "test:participant-ownership": "node scripts/verify-participant-ownership.js",
    "test:member-exit-analysis": "node scripts/verify-member-exit-analysis.js",
    "test:best-partners": "node scripts/verify-best-partners.js",
    "test:court-pricing": "node scripts/verify-court-pricing.js",
    "test:estimator": "node scripts/verify-estimator.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build:fresh && wrangler deploy",
    "d1:create": "wrangler d1 create Badminton",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "wrangler": "latest"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  }
}
